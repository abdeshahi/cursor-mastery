[Unit]
Description=VPN sales Telegram bot (Phase 1)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vpn-sales-bot
Environment=NODE_ENV=production
EnvironmentFile=/opt/vpn-sales-bot/.env
ExecStart=/usr/bin/env node /opt/vpn-sales-bot/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
