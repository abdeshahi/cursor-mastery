NODE_ENV=production
LOG_LEVEL=info

# --- PostgreSQL (business DB, Docker Compose) ---
# Used by docker compose AND by the bot/n8n. Never publish 0.0.0.0.
POSTGRES_DB=vpn_sales
POSTGRES_USER=vpn
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgres://vpn:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/vpn_sales

# Local-only health endpoint for the systemd bot
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3010

# --- Telegram ---
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs that can Approve/Reject payments
ADMIN_TELEGRAM_IDS=
# Optional. Use if the VPS cannot reach api.telegram.org directly.
# TELEGRAM_PROXY=http://127.0.0.1:1080

# Card-to-card details shown to customers (not used as API secrets)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK_NAME=
PAYMENT_NOTE=پس از واریز، تصویر رسید را همین‌جا ارسال کنید.

SUPPORT_USERNAME=
SUPPORT_MESSAGE=برای پشتیبانی به ادمین پیام بدهید.

# --- Marzban ---
MARZBAN_BASE_URL=https://panel.example.com
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_TIMEOUT_MS=15000
# JSON object. Must match inbounds enabled on your panel.
MARZBAN_PROXIES={"vless":{}}
MARZBAN_INBOUNDS={}
# Optional. Prepended when Marzban returns a relative subscription path.
# MARZBAN_SUBSCRIPTION_URL_PREFIX=https://sub.example.com

# Plan.node in PostgreSQL wins. Otherwise this label is stored on the subscription.
DEFAULT_NODE=node1
# NODE_2=node2

CONNECTION_APPS=v2rayNG (اندروید)، Streisand یا V2Box (آیفون)، v2rayN (ویندوز)
