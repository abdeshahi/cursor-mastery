{
  "name": "vpn-sales-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node dist/database/migrate.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "https-proxy-agent": "^7.0.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "undici": "^7.29.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
