# n8n image tag. "stable" tracks the current stable release.
N8N_VERSION=stable

# Bind address and published port on the VPS.
N8N_BIND_HOST=0.0.0.0
N8N_PORT=5678

# Public hostname or IP that browsers and webhooks will use.
# install.sh fills these in when you leave them blank.
N8N_HOST=
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=
WEBHOOK_URL=
# Must be false when serving over HTTP without TLS.
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=Asia/Tehran

# Generated by install.sh. Back this key up; losing it makes saved
# credentials unreadable.
N8N_ENCRYPTION_KEY=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=
POSTGRES_NON_ROOT_PASSWORD=

RUNNERS_AUTH_TOKEN=
