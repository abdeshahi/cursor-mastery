{
  "name": "cttel-news-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "poll-once": "tsx src/main.ts --once"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "https-proxy-agent": "^7.0.6",
    "@vitalets/google-translate-api": "^9.2.0",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
