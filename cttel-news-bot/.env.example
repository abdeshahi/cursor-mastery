# Telegram
BOT_TOKEN=
CHANNEL_ID=@your_channel
ADMIN_ID=
TELEGRAM_PROXY=

# Translation
# openai = LLM translation via OpenAI-compatible API (recommended)
# google = free Google Translate fallback
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Free OpenAI-compatible option (no billing):
# OPENAI_BASE_URL=https://api.free.ai/v1
# OPENAI_MODEL=qwen7b

# Feeds: comma-separated RSS URLs (overrides defaults when set)
FEED_URLS=

# Scheduler
POLL_CRON=*/30 * * * *
POLL_ON_START=true
MAX_POSTS_PER_RUN=3

# Storage
DATA_DIR=./data

# Server (health check + Persian article reader)
PORT=3002
PUBLIC_BASE_URL=http://185.18.214.66:3002
LOG_LEVEL=info
