# Telegram
BOT_TOKEN=
CHANNEL_ID=@your_channel
ADMIN_ID=
TELEGRAM_PROXY=

# Translation
# google = free, works on VPS without API key (default)
# openai = specialized LLM translation (requires OPENAI_API_KEY)
TRANSLATION_PROVIDER=google
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Feeds: comma-separated RSS URLs (overrides defaults when set)
FEED_URLS=

# Scheduler
POLL_CRON=*/30 * * * *
POLL_ON_START=true
MAX_POSTS_PER_RUN=3

# Storage
DATA_DIR=./data

# Server (health check)
PORT=3002
LOG_LEVEL=info
