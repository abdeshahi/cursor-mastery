# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cttel_dollar_bot

# Application
PAPER_MODE=true
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
APP_NAME=CTTEL Dollar Intelligence Bot
APP_VERSION=0.1.0

# Telegram (Phase 15)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# OpenAI (Phase 5)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduler intervals (Phase 14)
ANALYSIS_INTERVAL=900
NEWS_INTERVAL=600
MARKET_INTERVAL=300
SIGNAL_ALERT_THRESHOLD=0.1
