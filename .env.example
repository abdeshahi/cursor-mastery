# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cttel_dollar_bot

# Application
PAPER_MODE=true
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
APP_NAME=CTTEL Dollar Intelligence Bot
APP_VERSION=0.1.0

# Telegram (Phase 15)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# OpenAI (Phase 5)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduler intervals (Phase 14)
ANALYSIS_INTERVAL=900
NEWS_INTERVAL=600
MARKET_INTERVAL=300
SIGNAL_ALERT_THRESHOLD=0.1

# Market data providers (Phase 3)
# No authentication required: TGJU, Nobitex, Wallex
# API key required: FRED, Alpha Vantage
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
TGJU_BASE_URL=https://api.tgju.org/v1/market/indicator/summary-table-data
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=15
PROVIDER_MAX_RETRIES=3
MARKET_STALE_AFTER_SECONDS=86400

# News collection (Phase 4)
NEWS_CLUSTER_TITLE_SIMILARITY_THRESHOLD=0.85
NEWS_CLUSTER_TOKEN_SIMILARITY_THRESHOLD=0.45
NEWS_CLUSTER_COMBINED_THRESHOLD=0.78
NEWS_CLUSTER_DEFAULT_WINDOW_HOURS=48
NEWS_CLUSTER_MILITARY_WINDOW_HOURS=12
NEWS_CLUSTER_SANCTIONS_WINDOW_HOURS=72
NEWS_CLUSTER_NEGOTIATION_WINDOW_HOURS=48
NEWS_CLUSTER_ECONOMIC_WINDOW_HOURS=72

# News clustering (Phase 4)
NEWS_CLUSTER_TITLE_SIMILARITY_THRESHOLD=0.85
NEWS_CLUSTER_TOKEN_SIMILARITY_THRESHOLD=0.45
NEWS_CLUSTER_COMBINED_THRESHOLD=0.78
NEWS_CLUSTER_DEFAULT_WINDOW_HOURS=48
